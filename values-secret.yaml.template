# Secrets documentation can be found here:
# https://validatedpatterns.io/learn/secrets-management-in-the-validated-patterns-framework/
#
# A more formal description of this format can be found here:
# https://github.com/validatedpatterns/rhvp.cluster_utils/tree/main/roles/vault_utils#values-secret-file-format
version: "2.0"
# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

secrets:
  # ---------------------------------------------------------------------------
  # PRE-REQUISITE: Trilio license key
  # Must be populated in Vault BEFORE running `make install`.
  # The ESO ExternalSecret and the license Job both depend on this.
  # ---------------------------------------------------------------------------
  - name: trilio-license
    vaultPrefixes:
    - global
    fields:
    - name: key
      onMissingValue: error
      # ⚠ The key must be a single unbroken line with NO backslashes.
      # Trilio 5.2.x accidentally tolerates backslashes (shell variable
      # assignment strips them), but 5.3.x reads the raw Secret bytes and
      # will fail with "Unable to decode license key" if any are present.
      # If your key contains backslashes, strip them first:
      #   echo 'your-key' | tr -d '\\' | pbcopy

  # ---------------------------------------------------------------------------
  # PRE-REQUISITE: S3 credentials for Trilio BackupTarget
  # Must be populated in Vault BEFORE running `make install`.
  # If populated after ArgoCD sync, the ExternalSecret will recover within 5m
  # but the Target CR will remain in Failed state until the Secret appears.
  # Use an S3 bucket accessible from all clusters (hub and spoke).
  # ---------------------------------------------------------------------------
  - name: trilio-s3
    vaultPrefixes:
    - global
    fields:
    - name: accessKey
      onMissingValue: error
    - name: secretKey
      onMissingValue: error

